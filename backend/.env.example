# LLM provider: "openai" (any OpenAI-compatible chat API) or "anthropic".
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional: override for OpenAI-compatible providers (e.g. OpenRouter, Groq, Ollama).
LLM_BASE_URL=
# Seconds to wait for one LLM call (raise for slow local models).
LLM_TIMEOUT=180
#
# Local Ollama instead of a hosted API (no key needed):
#   ollama pull qwen2.5:3b
#   LLM_PROVIDER=openai  LLM_API_KEY=  LLM_MODEL=qwen2.5:3b  LLM_BASE_URL=http://localhost:11434/v1  LLM_RANK_BATCH=8
# Where to keep the SQLite cache.
JINGER_DB=jinger.db
